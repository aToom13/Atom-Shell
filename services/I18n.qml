pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Caelestia
import qs.utils

Singleton {
    id: root

    // "auto" | "tr" | "en"
    property string language: "auto"

    readonly property string systemLocale: {
        const envLang = Quickshell.env("LANG") || Quickshell.env("LC_ALL") || Quickshell.env("LC_MESSAGES") || "";
        const qtLoc = Qt.locale().name || "";
        return envLang || qtLoc;
    }

    readonly property bool systemIsTurkish: {
        const loc = systemLocale.toLowerCase();
        return loc.startsWith("tr") || loc.includes("tr_tr");
    }

    readonly property string currentLanguage: {
        if (language === "tr") return "tr";
        if (language === "en") return "en";
        return systemIsTurkish ? "tr" : "en";
    }

    readonly property bool isTurkish: currentLanguage === "tr"

    readonly property string configFile: Paths.config + "/language.json"

    function setLanguage(lang: string): void {
        if (lang !== "auto" && lang !== "tr" && lang !== "en") return;
        language = lang;
        saveConfig();
        try {
            CUtils.loadTranslation(currentLanguage);
        } catch (e) {}
    }

    function saveConfig(): void {
        const payload = JSON.stringify({ language: language }, null, 2);
        saveProc.command = ["python3", "-c", "import sys, pathlib, json; p = pathlib.Path(sys.argv[1]); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(sys.argv[2], encoding='utf-8')", configFile, payload];
        saveProc.running = true;
    }

    function loadConfig(): void {
        loadProc.command = ["python3", "-c", "import sys, pathlib, json; p = pathlib.Path(sys.argv[1]); sys.stdout.write(p.read_text(encoding='utf-8') if p.exists() else '{}')", configFile];
        loadProc.running = true;
    }

    Process {
        id: saveProc
    }

    Process {
        id: loadProc
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const data = JSON.parse(text);
                    if (data && data.language) {
                        root.language = data.language;
                    }
                } catch (e) {}
                try {
                    CUtils.loadTranslation(currentLanguage);
                } catch (e) {}
            }
        }
    }

    Component.onCompleted: {
        loadConfig();
    }

