    // Comprehensive Turkish to English reverse map (for fallback and Turkish sources)
    readonly property var trToEn: {
        const reverse = {};
        for (const [k, v] of Object.entries(enToTr)) {
            reverse[v] = k;
        }
        for (const [k, v] of Object.entries(trSources)) {
            reverse[k] = v;
        }
        return reverse;
    }

    // Bidirectional formatting translation function
    function t(text: string, ...args): string {
        if (!text) return "";
        let result = text;

        if (isTurkish) {
            // Translate English -> Turkish
            if (enToTr[text] !== undefined) {
                result = enToTr[text];
            }
        } else {
            // Translate Turkish -> English
            if (trToEn[text] !== undefined) {
                result = trToEn[text];
            }
        }

        // Interpolate %1, %2, ...
        if (args && args.length > 0) {
            for (let i = 0; i < args.length; i++) {
                const placeholder = "%" + (i + 1);
                result = String(result).split(placeholder).join(String(args[i] ?? ""));
            }
        }

        return result;
    }
}
